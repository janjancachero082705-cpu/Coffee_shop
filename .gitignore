# ═══════════════════════════════════════════════════
# Laravel .gitignore
# ═══════════════════════════════════════════════════

# === Dependencies ===
/vendor
/node_modules
/public/build
/public/hot
/public/storage

# === Environment ===
.env
.env.*
!.env.example
.env.backup
.env.production

# === Storage ===
/storage/*.key
/storage/pail
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/logs/*
!/storage/framework/cache/data/.gitignore
!/storage/framework/sessions/.gitignore
!/storage/framework/views/.gitignore
!/storage/logs/.gitignore

# === Bootstrap ===
/bootstrap/cache/*
!/bootstrap/cache/.gitignore

# === IDE ===
/.idea
/.vscode
/.fleet
/.nova
/.zed
/.phpactor.json
/.phpunit.cache
*.swp
*~

# === OS ===
.DS_Store
Thumbs.db

# === Logs ===
*.log
npm-debug.log*
yarn-error.log*

# === Testing ===
.phpunit.result.cache
/auth.json
Homestead.json
Homestead.yaml

# === Backup files ===
*.bak
*.bak_*
*.bak-*
*.old
*.orig
*.broken
*.broken_*
*.guba
*.guba_*
*.current_*
*.broken-backup

# === Temp scripts ===
tinker_*.php
tinker.php
temp_*.php
tmp_*.php
