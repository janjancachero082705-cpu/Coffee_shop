<style>
    .sr-stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 14px;
        margin-bottom: 20px;
    }

    .sr-stat {
        position: relative;
        padding: 18px 20px;
        background: rgba(34, 34, 44, 0.6);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 14px;
        overflow: hidden;
        transition: all 0.25s;
    }
    .sr-stat:hover {
        transform: translateY(-3px);
        border-color: var(--stat-border);
        box-shadow: 0 14px 30px -12px rgba(0, 0, 0, 0.6);
    }
    .sr-stat::before {
        content: '';
        position: absolute; top: 0; left: 0; right: 0; height: 2px;
        background: linear-gradient(90deg, transparent, var(--stat-color), transparent);
        opacity: 0;
        transition: opacity 0.25s;
    }
    .sr-stat:hover::before { opacity: 1; }

    .sr-stat.total    { --stat-color: #c9a961; --stat-border: rgba(169, 120, 74, 0.35); --stat-bg: rgba(169, 120, 74, 0.12); }
    .sr-stat.pending  { --stat-color: #f59e0b; --stat-border: rgba(245, 158, 11, 0.35); --stat-bg: rgba(245, 158, 11, 0.12); }
    .sr-stat.approved { --stat-color: #22c55e; --stat-border: rgba(34, 197, 94, 0.35);  --stat-bg: rgba(34, 197, 94, 0.12); }
    .sr-stat.rejected { --stat-color: #ef4444; --stat-border: rgba(239, 68, 68, 0.35);  --stat-bg: rgba(239, 68, 68, 0.12); }

    .sr-stat-head {
        display: flex; justify-content: space-between; align-items: center;
        margin-bottom: 12px;
    }
    .sr-stat-icon {
        width: 40px; height: 40px;
        border-radius: 11px;
        background: var(--stat-bg);
        border: 1px solid var(--stat-border);
        display: grid; place-items: center;
        color: var(--stat-color);
    }
    .sr-stat-label {
        font-size: 10.5px; font-weight: 700;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.12em;
    }
    .sr-stat-value {
        font-size: 28px; font-weight: 800;
        color: var(--text-primary);
        letter-spacing: -0.03em;
        line-height: 1;
    }

    /* Filter tabs */
    .sr-toolbar {
        display: flex;
        gap: 12px;
        align-items: center;
        padding: 14px 18px;
        background: rgba(34, 34, 44, 0.6);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 14px;
        margin-bottom: 16px;
        flex-wrap: wrap;
    }

    .sr-tabs {
        display: flex;
        gap: 4px;
        padding: 4px;
        background: rgba(20, 20, 26, 0.6);
        border: 1px solid var(--border);
        border-radius: 10px;
    }

    .sr-tab {
        padding: 7px 14px;
        border-radius: 7px;
        font-size: 12px;
        font-weight: 600;
        color: var(--text-secondary);
        cursor: pointer;
        transition: all 0.15s;
        text-decoration: none;
        white-space: nowrap;
    }
    .sr-tab:hover { color: var(--text-primary); }
    .sr-tab.active {
        background: linear-gradient(135deg, var(--accent), var(--accent-dark));
        color: #fff;
        box-shadow: 0 4px 12px -4px rgba(169, 120, 74, 0.5);
    }
    .sr-tab .count {
        display: inline-block;
        margin-left: 6px;
        padding: 1px 6px;
        background: rgba(255, 255, 255, 0.15);
        border-radius: 5px;
        font-size: 10px;
        font-weight: 800;
    }
    .sr-tab:not(.active) .count {
        background: rgba(255, 255, 255, 0.08);
        color: var(--text-muted);
    }

    .sr-search {
        position: relative;
        flex: 1;
        min-width: 200px;
    }
    .sr-search svg {
        position: absolute; left: 14px; top: 50%;
        transform: translateY(-50%);
        color: var(--text-muted);
        pointer-events: none;
    }
    .sr-search input {
        width: 100%;
        padding: 10px 14px 10px 40px;
        background: rgba(20, 20, 26, 0.7);
        border: 1px solid var(--border-strong);
        border-radius: 10px;
        color: var(--text-primary);
        font-size: 13px;
        font-family: inherit;
        outline: none;
    }
    .sr-search input:focus {
        border-color: var(--accent);
        box-shadow: 0 0 0 4px rgba(169, 120, 74, 0.15);
    }

    /* Table */
    .sr-card {
        background: rgba(34, 34, 44, 0.6);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 14px;
        overflow: hidden;
    }
    .sr-table { width: 100%; border-collapse: collapse; }
    .sr-table thead th {
        text-align: left;
        font-size: 10.5px;
        font-weight: 700;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.1em;
        padding: 14px 18px;
        border-bottom: 1px solid var(--border);
        background: rgba(20, 20, 26, 0.4);
        white-space: nowrap;
    }
    .sr-table tbody td {
        padding: 16px 18px;
        font-size: 13px;
        color: var(--text-secondary);
        border-bottom: 1px solid rgba(38, 38, 46, 0.7);
        vertical-align: middle;
    }
    .sr-table tbody tr { transition: background 0.15s; }
    .sr-table tbody tr:hover { background: rgba(169, 120, 74, 0.04); }
    .sr-table tbody tr:last-child td { border-bottom: none; }

    /* NEW badge */
    .sr-new-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 2px 8px;
        background: linear-gradient(135deg, #22c55e, #16a34a);
        color: #fff;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 0.06em;
        border-radius: 6px;
        text-transform: uppercase;
        margin-left: 8px;
        box-shadow: 0 3px 8px -2px rgba(34, 197, 94, 0.5);
    }
    .sr-new-badge::before {
        content: '';
        width: 5px; height: 5px;
        border-radius: 50%;
        background: #fff;
        animation: pulse 1.5s ease-in-out infinite;
    }
    @keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.4; }
    }

    /* Store cell */
    .sr-store-cell {
        display: flex;
        align-items: center;
        gap: 11px;
    }
    .sr-store-avatar {
        width: 40px; height: 40px;
        border-radius: 10px;
        background: linear-gradient(135deg, #c9a961, #8a5f36);
        display: grid; place-items: center;
        color: #fff;
        font-size: 13px;
        font-weight: 800;
        flex-shrink: 0;
        overflow: hidden;
        box-shadow: 0 4px 10px -4px rgba(169, 120, 74, 0.5);
    }
    .sr-store-avatar img { width: 100%; height: 100%; object-fit: cover; }
    .sr-store-info { min-width: 0; }
    .sr-store-name {
        font-size: 13px;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 2px;
    }
    .sr-store-code {
        font-size: 10.5px;
        color: var(--text-muted);
        font-family: ui-monospace, monospace;
    }

    /* Owner/email */
    .sr-meta-main { font-weight: 600; color: var(--text-primary); font-size: 12.5px; margin-bottom: 2px; }
    .sr-meta-sub  { font-size: 11px; color: var(--text-muted); }

    /* Date */
    .sr-date-main { font-weight: 600; color: var(--text-primary); font-size: 12.5px; margin-bottom: 2px; }
    .sr-date-sub  { font-size: 10.5px; color: var(--text-muted); }

    /* Status badge */
    .sr-status {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 11px;
        border-radius: 7px;
        font-size: 11px;
        font-weight: 700;
        text-transform: capitalize;
    }
    .sr-status::before {
        content: '';
        width: 6px; height: 6px;
        border-radius: 50%;
        background: currentColor;
    }
    .sr-status.pending  { background: rgba(245, 158, 11, 0.12); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.25); }
    .sr-status.approved { background: rgba(34, 197, 94, 0.12);  color: #22c55e; border: 1px solid rgba(34, 197, 94, 0.25); }
    .sr-status.rejected { background: rgba(239, 68, 68, 0.12);  color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.25); }

    /* Action buttons */
    .sr-actions {
        display: flex;
        gap: 6px;
        justify-content: flex-end;
    }
    .sr-btn {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 12px;
        border-radius: 7px;
        font-size: 11.5px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.15s;
        cursor: pointer;
        border: 1px solid transparent;
        font-family: inherit;
    }
    .sr-btn.view {
        background: rgba(169, 120, 74, 0.1);
        border-color: rgba(169, 120, 74, 0.25);
        color: var(--accent-light);
    }
    .sr-btn.view:hover { background: rgba(169, 120, 74, 0.2); }
    .sr-btn.approve {
        background: rgba(34, 197, 94, 0.12);
        border-color: rgba(34, 197, 94, 0.25);
        color: #22c55e;
    }
    .sr-btn.approve:hover { background: rgba(34, 197, 94, 0.22); }
    .sr-btn.reject {
        background: rgba(239, 68, 68, 0.12);
        border-color: rgba(239, 68, 68, 0.25);
        color: #ef4444;
    }
    .sr-btn.reject:hover { background: rgba(239, 68, 68, 0.22); }

    /* Empty */
    .sr-empty {
        padding: 60px 20px;
        text-align: center;
    }
    .sr-empty-icon {
        width: 64px; height: 64px;
        margin: 0 auto 16px;
        border-radius: 16px;
        background: var(--accent-bg);
        border: 1px solid var(--accent-border);
        display: grid; place-items: center;
        color: var(--accent-light);
    }
    .sr-empty-title {
        font-size: 16px;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 6px;
    }
    .sr-empty-text {
        font-size: 12.5px;
        color: var(--text-muted);
    }

    @media (max-width: 900px) {
        .sr-stats { grid-template-columns: repeat(2, 1fr); }
        .sr-toolbar { flex-direction: column; align-items: stretch; }
        .sr-tabs { overflow-x: auto; }
    }
    @media (max-width: 500px) {
        .sr-stats { grid-template-columns: 1fr; }
    }
</style>

