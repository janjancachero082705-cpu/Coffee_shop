    .item-card-body { display: flex; justify-content: space-between; align-items: center; font-size: 12px; color: var(--text-muted); padding-bottom: 12px; border-bottom: 1px solid var(--border); }
    .item-card-meta { display: inline-flex; align-items: center; gap: 5px; }
