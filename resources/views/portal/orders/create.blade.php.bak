        .modal-card { border-radius: 20px; }
    }
</style>
@endpush

@push('scripts')
<script>
    var cart = {};

    function openOrderModal(productId, productName, price, maxStock) {
        document.getElementById('modalProductName').textContent = productName;
        document.getElementById('modalProductPrice').textContent = '₱' + price.toFixed(2);
        document.getElementById('modalQty').value = 1;
        document.getElementById('modalQty').dataset.max = maxStock;
        document.getElementById('modalQty').dataset.price = price;
        document.getElementById('modalQty').dataset.productId = productId;
        document.getElementById('modalQty').dataset.productName = productName;
        updateModalSubtotal();
        document.getElementById('orderModal').classList.add('open');
    }

    function closeOrderModal(event) {
        if (event) event.stopPropagation();
        document.getElementById('orderModal').classList.remove('open');
    }

    function changeQty(delta) {
        var input = document.getElementById('modalQty');
        var max = parseInt(input.dataset.max) || 1;
        var current = parseInt(input.value) || 1;
        var newVal = current + delta;
        if (newVal < 1) newVal = 1;
        if (newVal > max) newVal = max;
        input.value = newVal;
        updateModalSubtotal();
    }

    function updateModalSubtotal() {
        var input = document.getElementById('modalQty');
        var qty = parseInt(input.value) || 0;
        var price = parseFloat(input.dataset.price) || 0;
        var subtotal = qty * price;
        document.getElementById('modalSubtotal').innerHTML = '&#8369;' + formatMoney(subtotal);
    }

    function confirmOrder() {
        var input = document.getElementById('modalQty');
        var productId = input.dataset.productId;
        var productName = input.dataset.productName;
        var qty = parseInt(input.value) || 0;
        var price = parseFloat(input.dataset.price) || 0;
        var maxStock = parseInt(input.dataset.max) || 0;

        if (qty < 1) return;

        if (qty > maxStock) {
            alert('Maximum stock: ' + maxStock);
            return;
        }

        cart[productId] = {
            product_id: productId,
            name: productName,
            qty: qty,
            price: price,
            subtotal: qty * price
        };

        closeOrderModal();
        renderCart();
        showToast(productName + ' added!');
    }

    function removeFromCart(productId) {
        delete cart[productId];
        renderCart();
        showToast('Item removed');
    }

    function renderCart() {
        var items = Object.values(cart);
        var container = document.getElementById('cartItems');
        var countEl = document.getElementById('cartCount');
        var totalEl = document.getElementById('cartTotal');
        var totalMini = document.getElementById('cartTotalMini');
        var hiddenEl = document.getElementById('hiddenItems');
        var submitBtn = document.getElementById('submitBtn');
        var floatingCart = document.getElementById('floatingCart');

        var totalQty = 0;
        var totalAmount = 0;

        if (items.length === 0) {
            container.innerHTML = '<div class="cart-empty"><div class="cart-empty-icon">🛒</div><div class="cart-empty-text">Walay items pa</div><div class="cart-empty-sub">Tap "Order Now" sa products</div></div>';
            countEl.style.display = 'none';
            totalEl.innerHTML = '&#8369;0.00';
            totalMini.innerHTML = '&#8369;0.00';
            hiddenEl.innerHTML = '';
            submitBtn.disabled = true;
            floatingCart.classList.add('empty');
            return;
        }

        var html = '';
        var hiddenHtml = '';
        items.forEach(function(item, index) {
            html += '<div class="cart-item">'
                + '<div class="cart-item-info">'
                +   '<div class="cart-item-name">' + escapeHtml(item.name) + '</div>'
                +   '<div class="cart-item-meta">' + item.qty + ' × ₱' + formatMoney(item.price) + '</div>'
                + '</div>'
                + '<div class="cart-item-price">₱' + formatMoney(item.subtotal) + '</div>'
                + '<button type="button" class="cart-item-remove" onclick="removeFromCart(' + item.product_id + ')">'
                +   '<svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 6L6 18M6 6l12 12"/></svg>'
                + '</button>'
                + '</div>';

            hiddenHtml += '<input type="hidden" name="items[' + index + '][product_id]" value="' + item.product_id + '">';
            hiddenHtml += '<input type="hidden" name="items[' + index + '][quantity]" value="' + item.qty + '">';

            totalQty += item.qty;
            totalAmount += item.subtotal;
        });

        container.innerHTML = html;
        countEl.textContent = totalQty;
        countEl.style.display = 'grid';
        totalEl.innerHTML = '&#8369;' + formatMoney(totalAmount);
        totalMini.innerHTML = '&#8369;' + formatMoney(totalAmount);
        hiddenEl.innerHTML = hiddenHtml;
        submitBtn.disabled = false;
        floatingCart.classList.remove('empty');
    }

    function toggleCart() {
        var drawer = document.getElementById('cartDrawer');
        var scrim = document.getElementById('drawerScrim');
        drawer.classList.toggle('open');
        scrim.classList.toggle('open');
    }

    function submitOrder() {
        if (Object.keys(cart).length === 0) return;

        var btn = document.getElementById('submitBtn');
        btn.disabled = true;
        btn.innerHTML = 'Submitting...';

        // Copy notes value from drawer to form
        var notes = document.getElementById('orderNotes').value;
        var notesInput = document.createElement('input');
        notesInput.type = 'hidden';
        notesInput.name = 'notes';
        notesInput.value = notes;
        document.getElementById('orderForm').appendChild(notesInput);

        document.getElementById('orderForm').submit();
    }

    function formatMoney(n) {
        return Number(n).toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function escapeHtml(s) {
        return String(s).replace(/[&<>"']/g, function(c) {
            return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
    }

    function showToast(message) {
        var existing = document.getElementById('quickToast');
        if (existing) existing.remove();

        var toast = document.createElement('div');
        toast.id = 'quickToast';
        toast.style.cssText = 'position:fixed;bottom:100px;left:50%;transform:translateX(-50%) translateY(20px);padding:10px 18px;background:rgba(34,197,94,0.95);color:#fff;font-size:12.5px;font-weight:600;border-radius:10px;z-index:9999;opacity:0;transition:all 0.3s;pointer-events:none;box-shadow:0 8px 20px -8px rgba(34,197,94,0.6);';
        toast.textContent = message;
        document.body.appendChild(toast);

        setTimeout(function() {
            toast.style.opacity = '1';
            toast.style.transform = 'translateX(-50%) translateY(0)';
        }, 10);

        setTimeout(function() {
            toast.style.opacity = '0';
            toast.style.transform = 'translateX(-50%) translateY(20px)';
            setTimeout(function() { toast.remove(); }, 300);
        }, 2000);
    }

    // Close modal on escape
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            closeOrderModal();
            if (document.getElementById('cartDrawer').classList.contains('open')) toggleCart();
        }
    });
</script>
@endpush