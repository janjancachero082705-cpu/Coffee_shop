{{-- ORDER MODAL --}}
<div class="modal-overlay" id="orderModal" onclick="closeOrderModal(event)">
    <div class="modal-card" onclick="event.stopPropagation();">
        <div class="modal-header">
            <div>
                <div class="modal-title" id="modalProductName">Product</div>
                <div class="modal-sub" id="modalProductPrice">₱0.00</div>
            </div>
            <button type="button" class="modal-close" onclick="closeOrderModal(event)">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 6L6 18M6 6l12 12"/></svg>
            </button>
        </div>

        <div class="modal-body">
            <label class="label">Quantity</label>
            <div class="qty-selector">
                <button type="button" class="qty-btn" onclick="changeQty(-1)">
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14"/></svg>
                </button>
                <input type="number" id="modalQty" class="qty-input" value="1" min="1" readonly>
                <button type="button" class="qty-btn" onclick="changeQty(1)">
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
                </button>
            </div>

            <div class="modal-total">
                <span>Subtotal</span>
                <strong id="modalSubtotal">&#8369;0.00</strong>
            </div>
        </div>

        <div class="modal-actions">
            <button type="button" class="btn-cancel" onclick="closeOrderModal(event)">Cancel</button>
            <button type="button" class="btn-confirm" onclick="confirmOrder()">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12l5 5L20 7"/></svg>
                Add to Order
            </button>
        </div>
    </div>
</div>

{{-- FLOATING CART BUTTON --}}
<div class="floating-cart" id="floatingCart" onclick="toggleCart()">
    <div class="cart-icon">
        <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <circle cx="9" cy="21" r="1"/>
            <circle cx="20" cy="21" r="1"/>
            <path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6"/>
        </svg>
        <span class="cart-count" id="cartCount" style="display:none;">0</span>
    </div>
    <div class="cart-info">
        <div class="cart-label">Your Order</div>
        <div class="cart-total-mini" id="cartTotalMini">&#8369;0.00</div>
    </div>
    <svg class="cart-arrow" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M9 18l6-6-6-6"/></svg>
</div>

{{-- CART DRAWER --}}
<div class="cart-drawer" id="cartDrawer">
    <div class="drawer-head">
        <div class="drawer-title">Your Order</div>
        <button type="button" class="drawer-close" onclick="toggleCart()">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 6L6 18M6 6l12 12"/></svg>
        </button>
    </div>

    <div class="drawer-body">
        <div class="cart-items" id="cartItems">
            <div class="cart-empty">
                <div class="cart-empty-icon">🛒</div>
                <div class="cart-empty-text">Walay items pa</div>
                <div class="cart-empty-sub">Tap "Order Now" sa products</div>
            </div>
        </div>
    </div>

    <div class="drawer-foot">
        <div class="drawer-notes">
            <label class="label">Notes (Optional)</label>
            <textarea name="notes" id="orderNotes" rows="2" class="input" placeholder="Special instructions..."></textarea>
        </div>

        <div class="drawer-total">
            <span>Total</span>
            <strong id="cartTotal">&#8369;0.00</strong>
        </div>

        <button type="button" class="btn-submit-final" id="submitBtn" onclick="submitOrder()" disabled>
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12l5 5L20 7"/></svg>
            Submit Order
        </button>
    </div>
</div>

