                        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
                        {{ \Carbon\Carbon::parse($order->requested_date)->format('M d, Y') }}
                    </div>
                    <div class="order-items">{{ $order->items->count() }} item(s)</div>
                </div>
                <div class="order-foot">
                    <div class="order-total">&#8369;{{ number_format($order->total_amount, 2) }}</div>
