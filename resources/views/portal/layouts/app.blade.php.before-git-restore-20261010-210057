    }
    .edit-header-icon {
        width: 60px; height: 60px;
        border-radius: 18px;
        background: linear-gradient(135deg, rgba(201, 169, 97, 0.15), rgba(138, 95, 54, 0.08));
        border: 1px solid rgba(201, 169, 97, 0.3);
        color: #c9a961;
        display: grid; place-items: center;
        margin: 0 auto 14px;
        box-shadow: 0 8px 24px -10px rgba(201, 169, 97, 0.5);
    }
    .edit-header-title {
        font-size: 20px;
        font-weight: 800;
        color: #fafafa;
        letter-spacing: -0.02em;
        margin-bottom: 4px;
    }
    .edit-header-sub {
        font-size: 12.5px;
        color: #71717a;
    }

    /* Form group */
    .form-group {
        margin-bottom: 16px;
        animation: profileSlideIn 0.5s cubic-bezier(0.4, 0, 0.2, 1) both;
    }
    .form-label {
        display: block;
        font-size: 11px;
        font-weight: 800;
        color: #a1a1aa;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 8px;
    }
    .form-label .req { color: #ef4444; margin-left: 2px; }

    .form-input,
    .form-select,
    .form-textarea {
        width: 100%;
        padding: 13px 16px;
        background: rgba(20, 20, 26, 0.55);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px;
        color: #fafafa;
        font-size: 13.5px;
        font-family: inherit;
        outline: none;
        transition: all 0.15s;
    }
    .form-input::placeholder { color: #52525b; }
    .form-input:focus {
        border-color: #c9a961;
        background: rgba(20, 20, 26, 0.85);
        box-shadow: 0 0 0 4px rgba(201, 169, 97, 0.15);
    }

    .form-alert {
        padding: 12px 16px;
        border-radius: 12px;
        font-size: 12.5px;
        font-weight: 600;
        margin-bottom: 16px;
        border: 1px solid;
        display: flex;
        align-items: center;
        gap: 9px;
    }
    .form-alert.error {
        background: rgba(239, 68, 68, 0.1);
        color: #fca5a5;
        border-color: rgba(239, 68, 68, 0.3);
    }

    .form-actions {
        display: flex;
        gap: 10px;
        margin-top: 24px;
        padding-top: 20px;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
    }
    .form-actions .p-btn { flex: 1; }

    /* Logo upload */
    .logo-upload {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 16px;
        background: rgba(20, 20, 26, 0.4);
        border: 1px dashed rgba(201, 169, 97, 0.35);
        border-radius: 14px;
        margin-bottom: 20px;
    }
    .logo-preview {
        width: 76px; height: 76px;
        border-radius: 18px;
        background: linear-gradient(135deg, #c9a961, #8a5f36);
        color: #fff;
        display: grid; place-items: center;
        font-size: 26px; font-weight: 900;
        flex-shrink: 0;
        overflow: hidden;
        box-shadow: 0 8px 22px -8px rgba(201, 169, 97, 0.6);
    }
    .logo-preview img { width: 100%; height: 100%; object-fit: cover; }
    .logo-info { flex: 1; min-width: 0; }
    .logo-title {
        font-size: 13px; font-weight: 800;
        color: #fafafa; margin-bottom: 4px;
    }
    .logo-hint {
        font-size: 11.5px; color: #71717a; margin-bottom: 10px;
    }
    .logo-buttons { display: flex; gap: 8px; flex-wrap: wrap; }
    .logo-btn {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 8px 14px; border-radius: 9px;
        font-size: 12px; font-weight: 700;
        font-family: inherit; cursor: pointer;
        transition: all 0.15s; border: 1px solid;
    }
    .logo-btn.upload {
        background: rgba(201, 169, 97, 0.12);
        border-color: rgba(201, 169, 97, 0.3);
        color: #c9a961;
    }
    .logo-btn.upload:hover {
        background: rgba(201, 169, 97, 0.22);
    }
    .logo-btn.remove {
        background: rgba(239, 68, 68, 0.08);
        border-color: rgba(239, 68, 68, 0.25);
        color: #ef4444;
    }
    .logo-btn.remove:hover { background: rgba(239, 68, 68, 0.18); }

    @keyframes profileSlideIn {
        0%   { opacity: 0; transform: translateY(12px); }
        100% { opacity: 1; transform: translateY(0); }
