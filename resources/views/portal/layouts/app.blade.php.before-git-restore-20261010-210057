         THEME INIT — SERVER-SIDE (zero flicker)
         Uses cookie para ma-read sa server AND localStorage for instant client
         ═══════════════════════════════════════════════════════════ --}}
    @php
        $serverTheme = request()->cookie('portal_theme', 'default');
        $validThemes = ['default', 'dark', 'light', 'blue'];
        if (!in_array($serverTheme, $validThemes)) { $serverTheme = 'default'; }
    @endphp
    <script>
    (function() {
        var t;
        try { t = localStorage.getItem('portal_theme'); } catch(e) {}
        if (!t || ['default','dark','light','blue'].indexOf(t) === -1) {
            t = '{{ $serverTheme }}';
            try { localStorage.setItem('portal_theme', t); } catch(e) {}
        }
        document.documentElement.setAttribute('data-theme', t);
        // SAVE to cookie para sa server-render sa sunod pages
        try {
            document.cookie = 'portal_theme=' + t + ';path=/;max-age=31536000;SameSite=Lax';
        } catch(e) {}
    })();
    </script>
