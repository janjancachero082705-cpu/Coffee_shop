<script>
(function() {
    'use strict';

    var themeNames = {
        'default': 'Default',
        'light': 'Light',
        'dark': 'Dark',
        'blue': 'Blue'
    };

    function applyTheme(theme) {
        // INSTANT — no delay, no flicker
        if (document.documentElement.getAttribute('data-theme') !== theme) {
            document.documentElement.setAttribute('data-theme', theme);
        }
        // INSTANT apply — walay delay
        document.documentElement.setAttribute('data-theme', theme);
        try { localStorage.setItem('portal_theme', theme); } catch(e) {}
        try { document.cookie = 'portal_theme=' + theme + ';path=/;max-age=31536000;SameSite=Lax'; } catch(e) {}

        // Update pill value
        var val = document.getElementById('pThemeValue');
        if (val) val.textContent = themeNames[theme] || 'Default';

        // Update popup active
        document.querySelectorAll('[data-theme-btn]').forEach(function(btn) {
            btn.classList.toggle('active', btn.dataset.themeBtn === theme);
        });

        console.log('[Theme] Applied:', theme);
    }

    function initTheme() {
        var saved = 'default';
        try { saved = localStorage.getItem('portal_theme') || 'default'; } catch(e) {}
        applyTheme(saved);

        // Row click → open popup
        var row = document.getElementById('pThemeRow');
        var popup = document.getElementById('pThemePopup');
        if (row && popup && !row._themeBound) {
            row._themeBound = true;
            row.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                popup.classList.add('open');
            });

            // Close on backdrop click
            popup.addEventListener('click', function(e) {
                if (e.target === popup) popup.classList.remove('open');
            });
        }

        // Option click → apply + close
        document.querySelectorAll('[data-theme-btn]').forEach(function(btn) {
            if (btn._themeBound) return;
            btn._themeBound = true;
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                applyTheme(btn.dataset.themeBtn);
                setTimeout(function() {
                    var p = document.getElementById('pThemePopup');
                    if (p) p.classList.remove('open');
                }, 200);
            });
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initTheme);
    } else {
        initTheme();
    }
    window.addEventListener('pageshow', initTheme);

    // ESC to close
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            var p = document.getElementById('pThemePopup');
            if (p && p.classList.contains('open')) p.classList.remove('open');
        }
    });
})();
</script>







{{-- ═══ FORCE LOGOUT STYLE v4 — ULTRA TRANSPARENT RED ═══ --}}
<script>
(function() {
    'use strict';

    // Ultra subtle color palette
    var COLORS = {
        bg:          'rgba(239, 68, 68, 0.06)',   // very light transparent red
        bgHover:     'rgba(239, 68, 68, 0.12)',   // slightly darker on hover
        bgActive:    'rgba(239, 68, 68, 0.18)',   // pressed
        border:      'rgba(220, 38, 38, 0.35)',   // transparent red border
        borderHover: 'rgba(220, 38, 38, 0.6)',    // darker on hover
        text:        '#ef4444',                    // bright red text
        textHover:   '#dc2626'                     // darker on hover
    };

    function applyStyle(btn, isHover) {
        var bg     = isHover ? COLORS.bgHover     : COLORS.bg;
        var border = isHover ? COLORS.borderHover : COLORS.border;
        var txt    = isHover ? COLORS.textHover   : COLORS.text;

        // Force background — very transparent red
        btn.style.setProperty('background',       bg,                'important');
        btn.style.setProperty('background-color', bg,                'important');
        btn.style.setProperty('background-image', 'none',            'important');
        btn.style.setProperty('box-shadow',       'none',            'important');
        btn.style.setProperty('text-shadow',      'none',            'important');

        // Border — transparent red
        btn.style.setProperty('border',        '1px solid ' + border, 'important');
        btn.style.setProperty('border-color',  border,                'important');
        btn.style.setProperty('border-width',  '1px',                 'important');
        btn.style.setProperty('border-style',  'solid',               'important');
        btn.style.setProperty('border-radius', '10px',                'important');

        // Text color
        btn.style.setProperty('color',      txt,   'important');
        btn.style.setProperty('font-weight','700', 'important');

        // Icon
        var svg = btn.querySelector('svg');
        if (svg) {
            svg.style.setProperty('color',  txt, 'important');
            svg.style.setProperty('stroke', txt, 'important');
            svg.style.setProperty('fill',   'none', 'important');
        }

        // Text span
        var span = btn.querySelector('span');
        if (span) {
            span.style.setProperty('color', txt, 'important');
        }
    }

    function forceLogoutStyle() {
        var selectors = [
            '.p-sidebar-foot form button.p-sidebar-foot-link.danger',
            '.p-sidebar-foot form button[type="submit"]',
            '.p-sidebar-foot-link.danger',
            'button.p-sidebar-foot-link.danger'
        ];

        var btns = document.querySelectorAll(selectors.join(','));
        btns.forEach(function(btn) {
            var isLogout = btn.classList.contains('danger') ||
                          btn.textContent.toLowerCase().indexOf('logout') !== -1;
            if (!isLogout) return;

            applyStyle(btn, false);

            if (!btn._logoutBound) {
                btn._logoutBound = true;
                btn.addEventListener('mouseenter', function() { applyStyle(btn, true); });
                btn.addEventListener('mouseleave', function() { applyStyle(btn, false); });
                btn.addEventListener('focus',      function() { applyStyle(btn, true); });
                btn.addEventListener('blur',       function() { applyStyle(btn, false); });
            }
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', forceLogoutStyle);
    } else {
        forceLogoutStyle();
    }

    window.addEventListener('pageshow', forceLogoutStyle);
    setInterval(forceLogoutStyle, 500);

    document.addEventListener('click', function(e) {
        if (e.target.closest('[data-theme-btn]')) {
            setTimeout(forceLogoutStyle, 50);
            setTimeout(forceLogoutStyle, 200);
            setTimeout(forceLogoutStyle, 600);
        }
    });

    try {
        var observer = new MutationObserver(function() { forceLogoutStyle(); });
        observer.observe(document.body, {
            attributes: true,
            attributeFilter: ['data-theme', 'class'],
            subtree: false
        });

    console.log('[Logout] Ultra transparent red force active');
})();
</script>

