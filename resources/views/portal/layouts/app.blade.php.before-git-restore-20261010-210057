    html[data-theme] .pp-stat,
    html[data-theme] .sr-stat,
    html[data-theme] .rr-stat,
    html[data-theme] .sr-kpi,
    html[data-theme] .rr-kpi,
    html[data-theme] .pf-stat,
    html[data-theme] .profile-stat,
    html[data-theme] .profile-stats {
