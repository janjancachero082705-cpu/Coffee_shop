<script id="SCROLL-CLEAN-JS">
(function () {
    'use strict';
    var SEL = '.profile-modal-overlay.open, .p-sidebar.open, .cart-drawer.open, .pm-overlay.show';

    function hasOpen() {
        var found = false;
        document.querySelectorAll(SEL).forEach(function (el) {
            if (found) return;
            var s = getComputedStyle(el);
            if (s.display !== 'none' && s.visibility !== 'hidden' && parseFloat(s.opacity) > 0) {
                var r = el.getBoundingClientRect();
                if (r.width > 0 && r.height > 0) found = true;
            }
        });
        return found;
    }

    function sync() {
        var open = hasOpen();
        var html = document.documentElement;
        var body = document.body;
        if (open) {
            html.classList.add('scroll-locked');
            body.classList.add('modal-open');
        } else {
            html.classList.remove('scroll-locked');
            body.classList.remove('modal-open', 'no-scroll', 'scroll-locked');
            if (body.style.overflow === 'hidden') body.style.overflow = '';
            if (html.style.overflow === 'hidden') html.style.overflow = '';
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', sync);
    } else {
        sync();
    }
    setInterval(sync, 400);
    document.addEventListener('click', function () { setTimeout(sync, 50); }, true);
    document.addEventListener('touchend', function () { setTimeout(sync, 50); }, true);
    window.__scrollSync = sync;
})();
</script>

