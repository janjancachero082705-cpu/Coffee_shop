    /* ════════════════════════════════════════════════════════
       THEME SWITCHER — MENU ROW STYLE
       ════════════════════════════════════════════════════════ */

    /* ── Theme Row (inside sidebar footer) ── */
    .p-theme-row {
        display: flex;
        align-items: center;
        gap: 10px;
        width: 100%;
        padding: 10px 12px;
        margin-bottom: 6px;
        background: transparent;
        border: none;
        border-radius: 10px;
        color: var(--t-text-2);
        font-family: inherit;
        font-size: 12.5px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.15s ease;
        text-align: left;
        -webkit-tap-highlight-color: transparent;
    }
    .p-theme-row:hover {
        background: rgba(var(--t-accent-rgb), 0.08);
    }
    .p-theme-row:active {
        background: rgba(var(--t-accent-rgb), 0.15);
    }

    .p-theme-row-icon {
        width: 20px;
        height: 20px;
        display: grid;
        place-items: center;
        flex-shrink: 0;
        color: var(--t-text-3);
        transition: color 0.15s;
    }
    .p-theme-row:hover .p-theme-row-icon {
        color: var(--t-accent);
    }

    .p-theme-row-label {
        flex: 1;
        min-width: 0;
        color: var(--t-text-2);
        font-weight: 600;
    }
    .p-theme-row:hover .p-theme-row-label {
        color: var(--t-text);
    }

    /* Current theme value pill */
    .p-theme-row-value {
        display: inline-flex;
        align-items: center;
        padding: 5px 12px;
        background: var(--t-input);
        border: 1px solid var(--t-border-2);
        border-radius: 100px;
        color: var(--t-text);
        font-size: 11.5px;
        font-weight: 700;
        letter-spacing: 0.01em;
        flex-shrink: 0;
        transition: all 0.15s;
    }
    .p-theme-row:hover .p-theme-row-value {
        border-color: var(--t-accent);
        color: var(--t-accent);
    }

    /* ═══ THEME POPUP (modal-style) ═══ */
    .p-theme-popup {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        z-index: 99999;
        background: var(--t-card-solid);
        border-top-left-radius: 20px;
        border-top-right-radius: 20px;
        border-top: 1px solid var(--t-border-2);
        box-shadow: 0 -20px 60px rgba(0, 0, 0, 0.5);
        padding: 8px;
        padding-bottom: max(8px, env(safe-area-inset-bottom));
        transform: translateY(100%);
        opacity: 0;
        visibility: hidden;
        transition: transform 0.3s cubic-bezier(0.34, 1.2, 0.64, 1), opacity 0.2s, visibility 0.2s;
    }
    .p-theme-popup.open {
        transform: translateY(0);
        opacity: 1;
        visibility: visible;
    }

    .p-theme-popup-head {
        padding: 12px 16px 8px;
        font-size: 11px;
        font-weight: 800;
        color: var(--t-text-3);
        text-transform: uppercase;
        letter-spacing: 0.12em;
        text-align: center;
    }

    .p-theme-option {
        display: flex;
        align-items: center;
        gap: 12px;
        width: 100%;
        padding: 14px 16px;
        background: transparent;
        border: none;
        border-radius: 12px;
        color: var(--t-text-2);
        font-family: inherit;
        font-size: 13.5px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.15s ease;
        text-align: left;
        -webkit-tap-highlight-color: transparent;
    }
    .p-theme-option:hover,
    .p-theme-option:active {
        background: rgba(var(--t-accent-rgb), 0.08);
    }

