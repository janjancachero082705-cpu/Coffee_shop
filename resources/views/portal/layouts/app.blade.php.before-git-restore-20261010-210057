    // Before unload — save current theme
    window.addEventListener('beforeunload', function() {
        try { localStorage.setItem('portal_theme', currentTheme); } catch(e) {}
    });

    // On pageshow (bfcache) — re-apply
    window.addEventListener('pageshow', function(e) {
        var saved = 'default';
        try { saved = localStorage.getItem('portal_theme') || 'default'; } catch(err) {}
        if (document.documentElement.getAttribute('data-theme') !== saved) {
            document.documentElement.setAttribute('data-theme', saved);
        }
    });

    // Observe theme changes
    var observer = new MutationObserver(function(mutations) {
        mutations.forEach(function(m) {
            if (m.attributeName === 'data-theme') {
                currentTheme = document.documentElement.getAttribute('data-theme');
                try { localStorage.setItem('portal_theme', currentTheme); } catch(err) {}
            }
        });
    });
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

    console.log('[Theme] Flicker guard active:', currentTheme);
})();
</script>















