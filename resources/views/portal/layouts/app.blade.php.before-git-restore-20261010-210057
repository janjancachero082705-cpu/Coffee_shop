<script id="THEME-GUARD">
(function(){
    'use strict';
    var key = 'portal_theme';
    var valid = ['default','dark','light','blue'];
    var lock = false;

    function expected() {
        try {
            var t = localStorage.getItem(key);
            if (!t || valid.indexOf(t) === -1) t = 'default';
            return t;
        } catch(e) { return 'default'; }
    }

    function enforce() {
        if (lock) return;
        var want = expected();
        var have = document.documentElement.getAttribute('data-theme');
        if (have !== want) {
            lock = true;
            document.documentElement.setAttribute('data-theme', want);
            setTimeout(function(){ lock = false; }, 0);
        }
    }

    // Watch attribute changes
    try {
        var mo = new MutationObserver(function(muts){
            for (var i = 0; i < muts.length; i++) {
                if (muts[i].attributeName === 'data-theme') {
                    enforce();
                    return;
                }
            }
        });
        mo.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    } catch(e) {}

    // Run on navigation events
    window.addEventListener('pageshow', enforce);
    document.addEventListener('visibilitychange', enforce);
    document.addEventListener('DOMContentLoaded', enforce);
    enforce();

    // Expose para ma-call kung mag-ilis theme
    window.__themeEnforce = enforce;
})();
</script>

<script id="LOGOUT-FORCE-JS">
(function() {
    'use strict';

    function killFill(btn) {
        if (!btn) return;

        // Button itself
        btn.style.setProperty('background', 'rgba(239, 68, 68, 0.08)', 'important');
        btn.style.setProperty('background-color', 'rgba(239, 68, 68, 0.08)', 'important');
        btn.style.setProperty('background-image', 'none', 'important');
        btn.style.setProperty('box-shadow', 'none', 'important');
        btn.style.setProperty('text-shadow', 'none', 'important');
        btn.style.setProperty('outline', 'none', 'important');
        btn.style.setProperty('filter', 'none', 'important');
        btn.style.setProperty('border', '1.5px solid #ef4444', 'important');
        btn.style.setProperty('border-color', '#ef4444', 'important');
        btn.style.setProperty('border-radius', '10px', 'important');
        btn.style.setProperty('color', '#ef4444', 'important');
        btn.style.setProperty('-webkit-text-fill-color', '#ef4444', 'important');

        // All children
        btn.querySelectorAll('*').forEach(function(el) {
            el.style.setProperty('background', 'transparent', 'important');
            el.style.setProperty('background-color', 'transparent', 'important');
            el.style.setProperty('background-image', 'none', 'important');
            el.style.setProperty('box-shadow', 'none', 'important');
            el.style.setProperty('text-shadow', 'none', 'important');
            el.style.setProperty('filter', 'none', 'important');
            el.style.setProperty('color', '#ef4444', 'important');
            el.style.setProperty('-webkit-text-fill-color', '#ef4444', 'important');
            if (el.tagName === 'svg' || el.tagName === 'SVG') {
                el.style.setProperty('stroke', '#ef4444', 'important');
                el.style.setProperty('fill', 'none', 'important');
            }
            if (el.tagName === 'path' || el.tagName === 'circle' || el.tagName === 'line' ||
                el.tagName === 'rect' || el.tagName === 'polyline' || el.tagName === 'polygon') {
                el.style.setProperty('stroke', '#ef4444', 'important');
                el.style.setProperty('fill', 'none', 'important');
            }
        });
    }

    function findAndKill() {
        // Find all possible logout buttons
        document.querySelectorAll(
            '.p-sidebar-foot-link.danger, ' +
            '.p-sidebar-foot form button[type="submit"], ' +
            '.p-sidebar form button[type="submit"], ' +
            'button[class*="danger"]'
        ).forEach(killFill);
    }

    // Run multiple times to be sure
    findAndKill();
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', findAndKill);
    }
    window.addEventListener('load', findAndKill);
    window.addEventListener('pageshow', findAndKill);
    setTimeout(findAndKill, 300);
    setTimeout(findAndKill, 1000);

    // Watch for changes
    var observer = new MutationObserver(function() {
        findAndKill();
    });
    observer.observe(document.body, { childList: true, subtree: true, attributes: true, attributeFilter: ['class', 'style'] });

    // Theme change
    document.addEventListener('click', function(e) {
        if (e.target.closest('[data-theme-btn]')) {
            setTimeout(findAndKill, 50);
            setTimeout(findAndKill, 300);
            setTimeout(findAndKill, 800);
        }
    });
})();
</script>
