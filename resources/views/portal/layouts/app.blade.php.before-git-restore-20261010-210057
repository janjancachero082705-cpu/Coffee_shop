    html[data-theme="light"]   { background-color: #f8fafc; color-scheme: light; }
    html[data-theme="blue"]    { background-color: #eff6ff; color-scheme: light; }
    html:not([data-theme]) body { visibility: hidden; }
    html[data-theme] body { visibility: visible; }
