        border-color: var(--th-border-accent) !important;
    }
    html[data-theme] .pp-stat-value,
    html[data-theme] .sr-kpi-value,
    html[data-theme] .rr-kpi-value,
    html[data-theme] .pf-stat-value,
    html[data-theme] .profile-stat-value {
        color: var(--th-text-primary) !important;
    }
    html[data-theme] .pp-stat-label,
    html[data-theme] .sr-kpi-label,
    html[data-theme] .rr-kpi-label,
    html[data-theme] .pf-stat-label,
    html[data-theme] .profile-stat-label {
        color: var(--th-text-muted) !important;
    }

    /* ═══ SIDEBAR OVERLAY ═══ */
    html[data-theme] .p-sidebar-overlay {
        background: var(--th-overlay-bg) !important;
    }

    /* ═══ SKELETONS ═══ */
    html[data-theme] .profile-skeleton-hero,
    html[data-theme] .profile-skeleton-card {
        background: linear-gradient(90deg,
            color-mix(in srgb, var(--th-text-muted) 15%, transparent) 0%,
            color-mix(in srgb, var(--th-text-muted) 25%, transparent) 50%,
            color-mix(in srgb, var(--th-text-muted) 15%, transparent) 100%) !important;
        background-size: 200% 100% !important;
    }

    /* ═══ PROGRESS BARS ═══ */
    html[data-theme] .sr-progress-track,
    html[data-theme] .sr-group-progress-bar,
    html[data-theme] .rr-group-progress-bar {
        background: var(--th-input-bg) !important;
        border: 1px solid var(--th-border) !important;
    }
    html[data-theme] .sr-progress-fill,
    html[data-theme] .sr-group-progress-fill,
    html[data-theme] .rr-group-progress-fill {
        background: var(--th-gradient-primary) !important;
    }
    html[data-theme] .sr-progress-fill.complete {
        background: linear-gradient(90deg, #22c55e, #16a34a) !important;
    }

    /* ═══ SIDEBAR FOOTER ═══ */
    html[data-theme] .p-sidebar-foot {
        background: color-mix(in srgb, var(--th-bg) 60%, transparent) !important;
        border-top-color: var(--th-border) !important;
    }
    html[data-theme] .p-sidebar-foot-link {
        color: var(--th-text-secondary) !important;
    }
    html[data-theme] .p-sidebar-foot-link svg {
        color: var(--th-icon) !important;
    }
    html[data-theme] .p-sidebar-foot-link:hover {
        background: var(--th-accent-subtle) !important;
        color: var(--th-text-primary) !important;
    }
    html[data-theme] .p-sidebar-foot-link:hover svg {
        color: var(--th-accent) !important;
    }
    html[data-theme] .p-sidebar-foot-link.danger:hover {
        background: rgba(239, 68, 68, 0.15) !important;
        color: #ef4444 !important;
    }

    /* ═══ SIDEBAR CLOSE BUTTON ═══ */
    html[data-theme] .p-sidebar-close {
        background: var(--th-input-bg) !important;
        border-color: var(--th-border) !important;
        color: var(--th-text-secondary) !important;
    }
    html[data-theme] .p-sidebar-close:hover {
        background: var(--th-accent-subtle) !important;
        border-color: var(--th-border-accent) !important;
        color: var(--th-accent) !important;
    }

    /* ═══ BADGES — keep semantic colors ═══ */
    html[data-theme] .p-badge,
    html[data-theme] .pp-badge,
    html[data-theme] .rr-status {
        color: inherit !important;
    }

    /* ═══ EMPTY STATES ═══ */
    html[data-theme] .p-empty-title,
    html[data-theme] .sr-empty-title,
    html[data-theme] .rr-empty-state-title {
        color: var(--th-text-primary) !important;
    }
    html[data-theme] .p-empty-text,
    html[data-theme] .sr-empty-sub {
        color: var(--th-text-muted) !important;
    }

    /* ═══ COMPANY NAME / HEADER TEXT ═══ */
    html[data-theme] .sr-title,
    html[data-theme] .rr-title,
    html[data-theme] .sr-group-title {
        color: var(--th-text-primary) !important;
    }
    html[data-theme] .sr-subtitle,
    html[data-theme] .rr-subtitle {
        color: var(--th-text-muted) !important;
    }
    html[data-theme] .sr-grouped-badge,
    html[data-theme] .rr-grouped-badge {
        background: var(--th-accent-subtle) !important;
        color: var(--th-accent) !important;
        border-color: var(--th-border-accent) !important;
    }

    /* ═══ HERO SECTIONS ═══ */
    html[data-theme] .profile-hero,
    html[data-theme] .rq-hero,
    html[data-theme] .sr-hero {
        background: var(--th-gradient-hero) !important;
        border-color: var(--th-border) !important;
    }
    html[data-theme] .rq-hero-icon,
    html[data-theme] .sr-hero-icon,
    html[data-theme] .profile-avatar-wrap,
    html[data-theme] .profile-avatar {
        /* Keep status color */
    }
    html[data-theme] .profile-avatar {
        background: var(--th-gradient-primary) !important;
        color: #ffffff !important;
    }
    html[data-theme] .profile-code,
    html[data-theme] .rq-hero-code,
    html[data-theme] .sr-hero-code,
    html[data-theme] .rq-hero-label,
    html[data-theme] .sr-hero-label {
        color: var(--th-accent) !important;
    }
    html[data-theme] .profile-name {
        color: var(--th-text-primary) !important;
    }
    html[data-theme] .profile-hero-glow {
        background: radial-gradient(circle, var(--th-accent), transparent 70%) !important;
    }

    /* ═══ ICON WRAPPERS ═══ */
    html[data-theme] .info-icon svg,
    html[data-theme] .pf-info-icon svg,
    html[data-theme] .p-card-icon svg,
    html[data-theme] .sr-card-icon svg,
    html[data-theme] .rq-card-icon svg {
        stroke: currentColor !important;
    }

    /* ═══ ALL SVG DEFAULTS ═══ */
    html[data-theme] button svg,
    html[data-theme] a svg {
        transition: stroke 0.2s ease, color 0.2s ease;
    }

    /* ═══ DIVIDERS ═══ */
    html[data-theme] .info-row,
    html[data-theme] .rr-info-row,
    html[data-theme] .pf-info-row,
    html[data-theme] .sr-detail-row,
    html[data-theme] .summary-row {
        border-color: var(--th-border) !important;
    }

    /* ═══ SEARCH ICONS ═══ */
    html[data-theme] .sr-search-icon,
    html[data-theme] .rr-search-icon {
        color: var(--th-icon) !important;
    }

    /* ═══ SIDEBAR SCROLL / BORDER ═══ */
    html[data-theme] .p-sidebar-nav

    /* ═══ BODY SCROLLBAR ═══ */
    html[data-theme] body

    /* ═══ NOTIFICATION OVERLAY ═══ */
    html[data-theme] .pn-popup {
        background: var(--th-card-solid) !important;
        border-color: var(--th-border-accent) !important;
        box-shadow: var(--th-shadow-lg), 0 0 40px -10px var(--th-accent-glow) !important;
    }
    html[data-theme] .pn-popup .pn-title {
        color: var(--th-text-primary) !important;
    }
    html[data-theme] .pn-popup .pn-message {
        color: var(--th-text-secondary) !important;
    }
    /* ════════════════════════════════════════════════════════
       THEME SYSTEM v4 — CLEAN & COMPLETE
       ════════════════════════════════════════════════════════ */

    /* ── 4. LIGHT BLUE (Icy Blue) ── */
    html[data-theme="blue"] {
        --t-bg: #eff6ff;
        --t-card: #ffffff;
        --t-card-solid: #ffffff;
        --t-elevated: rgba(219, 234, 254, 0.97);
        --t-input: #ffffff;
        --t-text: #0c1e3d;
        --t-text-2: #334155;
        --t-text-3: #64748b;
        --t-accent: #3b82f6;
        --t-accent-2: #1d4ed8;
        --t-accent-rgb: 59, 130, 246;
        --t-border: rgba(59, 130, 246, 0.15);
        --t-border-2: rgba(59, 130, 246, 0.3);
        --t-bg-img: none;
        --t-bg-img-op: 0;
        --t-bg-overlay: none;
    }

    /* ═══════════════════════════════════════════════════════
       APPLY — Body & Background
       ═══════════════════════════════════════════════════════ */
    html[data-theme] body {
        background-color: var(--t-bg) !important;
        background-image: none !important;
        color: var(--t-text) !important;
    }
    html[data-theme] body::before {
        background-image: var(--t-bg-img) !important;
        opacity: var(--t-bg-img-op) !important;
    }
    html[data-theme] body::after {
        background: var(--t-bg-overlay) !important;
    }

    /* ═══════════════════════════════════════════════════════
       TOPBAR
       ═══════════════════════════════════════════════════════ */
    html[data-theme] .p-topbar,
    html[data-theme] header.p-topbar {
        background: var(--t-elevated) !important;
        border-bottom-color: var(--t-border) !important;
        backdrop-filter: blur(20px) !important;
    }
    html[data-theme] .p-topbar-store-name {
        color: var(--t-text) !important;
    }
    html[data-theme] .p-topbar-store-code {
        color: var(--t-accent) !important;
    }

    /* ═══════════════════════════════════════════════════════
       SIDEBAR
       ═══════════════════════════════════════════════════════ */
    html[data-theme] .p-sidebar {
        background: linear-gradient(180deg, var(--t-card-solid), var(--t-bg)) !important;
        border-right-color: var(--t-border) !important;
        color: var(--t-text) !important;
    }
    html[data-theme] .p-sidebar-title { color: var(--t-text) !important; }
    html[data-theme] .p-sidebar-sub,
    html[data-theme] .p-sidebar-section-title,
    html[data-theme] .p-sidebar-user-email {
        color: var(--t-text-3) !important;
    }
    html[data-theme] .p-sidebar-user-name { color: var(--t-text) !important; }
    html[data-theme] .p-sidebar-link {
        color: var(--t-text-2) !important;
    }
    html[data-theme] .p-sidebar-link svg { color: var(--t-text-3) !important; }
    html[data-theme] .p-sidebar-link:hover {
        color: var(--t-text) !important;
        background: rgba(var(--t-accent-rgb), 0.08) !important;
    }
    html[data-theme] .p-sidebar-link:hover svg { color: var(--t-accent) !important; }
    html[data-theme] .p-sidebar-link.active {
        color: #ffffff !important;
        background: linear-gradient(135deg, var(--t-accent), var(--t-accent-2)) !important;
        box-shadow: 0 6px 16px -6px rgba(var(--t-accent-rgb), 0.5) !important;
    }
    html[data-theme] .p-sidebar-link.active svg { color: #ffffff !important; }
    html[data-theme] .p-sidebar-logo,
    html[data-theme] .p-sidebar-user-avatar {
        background: linear-gradient(135deg, var(--t-accent), var(--t-accent-2)) !important;
        color: #ffffff !important;
    }
    html[data-theme] .p-sidebar-close {
        background: var(--t-input) !important;
        border-color: var(--t-border) !important;
        color: var(--t-text-2) !important;
    }
    html[data-theme] .p-sidebar-user {
        background: rgba(var(--t-accent-rgb), 0.08) !important;
        border-color: rgba(var(--t-accent-rgb), 0.2) !important;
    }
    html[data-theme] .p-sidebar-foot {
        border-top-color: var(--t-border) !important;
    }
    html[data-theme] .p-sidebar-foot-link {
        color: var(--t-text-2) !important;
    }
    html[data-theme] .p-sidebar-foot-link svg { color: var(--t-text-3) !important; }
    html[data-theme] .p-sidebar-foot-link:hover {
        background: rgba(var(--t-accent-rgb), 0.08) !important;
        color: var(--t-text) !important;
    }
    html[data-theme] .p-sidebar-foot-link:hover svg { color: var(--t-accent) !important; }
    html[data-theme] .p-sidebar-overlay {
        background: rgba(0, 0, 0, 0.6) !important;
    }

    /* ═══════════════════════════════════════════════════════
       CARDS — ALL TYPES
       ═══════════════════════════════════════════════════════ */
    html[data-theme] .p-card,
    html[data-theme] .sr-card,
    html[data-theme] .rr-card,
    html[data-theme] .rq-card,
    html[data-theme] .pf-card {
        background: var(--t-card) !important;
        border-color: var(--t-border) !important;
        color: var(--t-text) !important;
    }
    html[data-theme] .p-card:hover {
        background: var(--t-card) !important;
        border-color: var(--t-border-2) !important;
    }
    html[data-theme] .p-card-title,
    html[data-theme] .sr-card-title,
    html[data-theme] .rr-card-title,
    html[data-theme] .rq-card-title,
    html[data-theme] .pf-card-title {
        color: var(--t-text) !important;
    }
    html[data-theme] .p-card-sub,
    html[data-theme] .sr-card-sub,
    html[data-theme] .rr-card-sub,
    html[data-theme] .rq-card-sub,
    html[data-theme] .pf-card-sub {
        color: var(--t-text-3) !important;
    }
    html[data-theme] .p-card-icon,
    html[data-theme] .sr-card-icon,
    html[data-theme] .rr-card-icon,
    html[data-theme] .rq-card-icon,
    html[data-theme] .pf-card-icon {
        background: rgba(var(--t-accent-rgb), 0.12) !important;
        border-color: rgba(var(--t-accent-rgb), 0.25) !important;
        color: var(--t-accent) !important;
    }

    /* ═══════════════════════════════════════════════════════
       NAV TABS
       ═══════════════════════════════════════════════════════ */
    html[data-theme] .p-nav {
        background: var(--t-elevated) !important;
        border-bottom-color: var(--t-border) !important;
    }
    html[data-theme] .p-nav-item {
        background: rgba(var(--t-accent-rgb), 0.04) !important;
        color: var(--t-text-2) !important;
        border-color: transparent !important;
    }
    html[data-theme] .p-nav-item:hover {
        color: var(--t-text) !important;
        background: rgba(var(--t-accent-rgb), 0.1) !important;
        border-color: rgba(var(--t-accent-rgb), 0.25) !important;
    }
    html[data-theme] .p-nav-item.active {
        color: #ffffff !important;
        background: linear-gradient(135deg, var(--t-accent), var(--t-accent-2)) !important;
    }

    /* ═══════════════════════════════════════════════════════
       INPUTS — ALL FORMS
       ═══════════════════════════════════════════════════════ */
    html[data-theme] .p-input,
    html[data-theme] .p-select,
    html[data-theme] .p-textarea,
    html[data-theme] .form-input,
    html[data-theme] .form-select,
    html[data-theme] .form-textarea,
    html[data-theme] input[type="text"],
    html[data-theme] input[type="email"],
    html[data-theme] input[type="password"],
    html[data-theme] input[type="number"],
    html[data-theme] input[type="date"],
    html[data-theme] select,
    html[data-theme] textarea {
        background: var(--t-input) !important;
        border-color: var(--t-border-2) !important;
        color: var(--t-text) !important;
    }
    html[data-theme] input::placeholder,
    html[data-theme] textarea::placeholder {
        color: var(--t-text-3) !important;
        opacity: 0.8 !important;
    }
    html[data-theme] input:focus,
    html[data-theme] select:focus,
    html[data-theme] textarea:focus {
        border-color: var(--t-accent) !important;
        box-shadow: 0 0 0 3px rgba(var(--t-accent-rgb), 0.15) !important;
    }
    html[data-theme] .p-label,
    html[data-theme] .form-label,
    html[data-theme] label {
        color: var(--t-text-2) !important;
    }

    /* ═══════════════════════════════════════════════════════
       BUTTONS
       ═══════════════════════════════════════════════════════ */
    html[data-theme] .p-btn-primary,
    html[data-theme] .pp-action,
    html[data-theme] .sr-filter-btn,
    html[data-theme] .rr-filter-btn {
        background: linear-gradient(135deg, var(--t-accent), var(--t-accent-2)) !important;
        color: #ffffff !important;
        box-shadow: 0 8px 20px -8px rgba(var(--t-accent-rgb), 0.6) !important;
    }
    html[data-theme] .p-btn-ghost,
    html[data-theme] .pp-action-ghost,
    html[data-theme] .sr-clear-btn,
    html[data-theme] .rr-clear-btn,
    html[data-theme] .rq-back-btn {
        background: var(--t-input) !important;
        color: var(--t-text-2) !important;
        border-color: var(--t-border-2) !important;
    }
    html[data-theme] .p-btn-ghost:hover,
    html[data-theme] .rq-back-btn:hover {
        background: rgba(var(--t-accent-rgb), 0.1) !important;
        color: var(--t-text) !important;
        border-color: var(--t-accent) !important;
    }

    /* ═══════════════════════════════════════════════════════
       STAT CARDS (Dashboard) — CRITICAL
       ═══════════════════════════════════════════════════════ */
    html[data-theme] .pp-stat,
    html[data-theme] .stats-grid > *,
    html[data-theme] [class*="stat-card"],
    html[data-theme] [class*="stats-item"] {
        background: var(--t-card) !important;
        border-color: var(--t-border) !important;
        color: var(--t-text) !important;
    }
    html[data-theme] [class*="stat-label"],
    html[data-theme] [class*="stat-lbl"],
    html[data-theme] [class*="stats-label"] {
        color: var(--t-text-3) !important;
    }
    html[data-theme] [class*="stat-value"],
    html[data-theme] [class*="stats-value"] {
        color: var(--t-text) !important;
    }

    /* ═══════════════════════════════════════════════════════
       FLOATING BUTTONS
       ═══════════════════════════════════════════════════════ */
    html[data-theme] .p-float-hamburger,
    html[data-theme] .p-float-btn,
    html[data-theme] #pHamburger {
        background: linear-gradient(135deg, var(--t-accent), var(--t-accent-2)) !important;
        border-color: transparent !important;
        color: #ffffff !important;
        box-shadow: 0 8px 20px -6px rgba(var(--t-accent-rgb), 0.5) !important;
    }
    html[data-theme] .p-float-hamburger svg,
    html[data-theme] #pHamburger svg {
        stroke: #ffffff !important;
    }
    html[data-theme] .p-float-hamburger:hover,
    html[data-theme] #pHamburger:hover {
        background: linear-gradient(135deg, var(--t-accent-2), var(--t-accent)) !important;
        box-shadow: 0 12px 28px -6px rgba(var(--t-accent-rgb), 0.7) !important;
    }

    /* ═══════════════════════════════════════════════════════
       NOTIFICATION BELL + PANEL
       ═══════════════════════════════════════════════════════ */
    html[data-theme] .pn-bell {
        background: linear-gradient(135deg, var(--t-accent), var(--t-accent-2)) !important;
        color: #ffffff !important;
        box-shadow: 0 8px 24px -6px rgba(var(--t-accent-rgb), 0.6) !important;
    }
    html[data-theme] .pn-bell svg { stroke: #ffffff !important; }
    html[data-theme] .pn-badge {
        background: #ef4444 !important;
        color: #ffffff !important;
        border-color: var(--t-bg) !important;
    }
    html[data-theme] .pn-panel {
        background: var(--t-card-solid) !important;
        border-color: var(--t-border-2) !important;
    }
    html[data-theme] .pn-head {
        border-bottom-color: var(--t-border) !important;
    }
    html[data-theme] .pn-head-title {
        color: var(--t-text) !important;
    }
    html[data-theme] .pn-head-title svg { color: var(--t-accent) !important; }
    html[data-theme] .pn-mark-all { color: var(--t-accent) !important; }
    html[data-theme] .pn-item {
        border-bottom-color: var(--t-border) !important;
    }
    html[data-theme] .pn-item:hover {
        background: rgba(var(--t-accent-rgb), 0.06) !important;
    }
    html[data-theme] .pn-item .pn-title { color: var(--t-text) !important; }
    html[data-theme] .pn-item .pn-message { color: var(--t-text-2) !important; }
    html[data-theme] .pn-item .pn-time { color: var(--t-text-3) !important; }

    /* ═══════════════════════════════════════════════════════
       MODALS
       ═══════════════════════════════════════════════════════ */
    html[data-theme] .profile-modal,
    html[data-theme] .rq-modal {
        background: var(--t-card-solid) !important;
        border-color: var(--t-border-2) !important;
        color: var(--t-text) !important;
    }
    html[data-theme] .profile-modal-header,
