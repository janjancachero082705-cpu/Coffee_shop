    }
    .hero-btn-ghost:hover {
        background: rgba(255, 255, 255, 0.1);
        color: var(--text-primary);
    }

    /* ===== KPI GRID ===== */
    .p-kpi-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
