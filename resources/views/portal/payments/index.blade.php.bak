            <a href="{{ route('portal.payments.show', $p->id) }}" class="item-card">
                <div class="item-card-head">
                    <div class="item-card-number">{{ $p->payment_number }}</div>
                    <div class="item-card-amount">+ &#8369;{{ number_format($p->amount, 2) }}</div>
                </div>
                <div class="item-card-body">
