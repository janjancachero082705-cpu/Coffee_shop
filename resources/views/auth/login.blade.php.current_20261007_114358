<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
    <meta name="csrf-token" content="{{ csrf_token() }}">
    <title>Login - Coffee Beans</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        html, body {
            width: 100%;
            min-height: 100vh;
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            background: #0f0f14;
            color: #f5f3f0;
            -webkit-font-smoothing: antialiased;
            overflow-x: hidden;
        }

        body::before {
            content: '';
            position: fixed; inset: 0;
            background-image: url('https://images.unsplash.com/photo-1447933601403-0c6688de566e?auto=format&fit=crop&w=1920&q=80');
            background-size: cover;
            background-position: center;
            z-index: -2;
        }
        body::after {
            content: '';
            position: fixed; inset: 0;
            background: linear-gradient(180deg, rgba(15,15,20,0.78), rgba(10,10,16,0.88));
            z-index: -1;
        }

        .login-wrap {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            padding: 20px;
        }

        .login-card {
            width: 100%;
            max-width: 420px;
            background: linear-gradient(165deg, #1e1a16 0%, #15120f 100%);
            border: 1px solid rgba(201, 169, 97, 0.25);
            border-radius: 24px;
            padding: 32px 28px 28px;
            box-shadow:
                0 30px 60px -20px rgba(0, 0, 0, 0.8),
                0 0 0 1px rgba(255, 255, 255, 0.03) inset,
                0 0 80px -30px rgba(201, 169, 97, 0.35);
            animation: cardIn 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }
        @keyframes cardIn {
            from { opacity: 0; transform: translateY(20px) scale(0.96); }
            to   { opacity: 1; transform: translateY(0) scale(1); }
        }

        /* LOGO */
        .logo-wrap {
            text-align: center;
            margin-bottom: 24px;
        }
        .logo-icon {
            width: 64px;
            height: 64px;
            margin: 0 auto 12px;
            border-radius: 18px;
            background: linear-gradient(135deg, #c9a961, #8a5f36);
            display: grid;
            place-items: center;
            box-shadow: 0 12px 32px -10px rgba(201, 169, 97, 0.7);
        }
        .logo-title {
            font-size: 22px;
            font-weight: 800;
            color: #f5f3f0;
            letter-spacing: -0.02em;
        }
        .logo-title span { color: #c9a961; }
        .logo-sub {
            font-size: 11.5px;
            color: #8a8378;
            margin-top: 4px;
            text-transform: uppercase;
            letter-spacing: 0.15em;
            font-weight: 700;
        }

        /* TABS */
        .login-tabs {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 6px;
            padding: 5px;
            background: rgba(0, 0, 0, 0.3);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 14px;
            margin-bottom: 22px;
            position: relative;
        }
        .login-tab {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            padding: 11px 12px;
            background: transparent;
            border: none;
            border-radius: 10px;
            color: #8a8378;
            font-size: 12.5px;
            font-weight: 800;
            font-family: inherit;
            cursor: pointer;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .login-tab:hover { color: #c4bdb4; }
        .login-tab.active {
            background: linear-gradient(135deg, #c9a961, #8a5f36);
            color: #fff;
            box-shadow: 0 6px 16px -6px rgba(201, 169, 97, 0.7);
        }
        .login-tab svg { flex-shrink: 0; }

        /* FORMS */
        .login-form {
            display: none;
            animation: formFade 0.25s ease;
        }
        .login-form.active { display: block; }
        @keyframes formFade {
            from { opacity: 0; transform: translateY(6px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        .field {
            margin-bottom: 16px;
        }
        .field-label {
            display: block;
            font-size: 11.5px;
            font-weight: 700;
            color: #c4bdb4;
            margin-bottom: 7px;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
        .field-input {
            width: 100%;
            padding: 13px 15px;
            background: rgba(0, 0, 0, 0.4);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 12px;
            color: #f5f3f0;
            font-size: 14px;
            font-family: inherit;
            outline: none;
            transition: border-color 0.15s, box-shadow 0.15s;
        }
        .field-input:focus {
            border-color: #c9a961;
            box-shadow: 0 0 0 4px rgba(201, 169, 97, 0.12);
        }
        .field-input::placeholder { color: #5a544c; }

        .field-check {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 18px;
            font-size: 12.5px;
            color: #a8a5a0;
            cursor: pointer;
            user-select: none;
        }
        .field-check input {
            width: 16px;
            height: 16px;
            accent-color: #c9a961;
            cursor: pointer;
        }

        .btn-login {
            width: 100%;
            min-height: 50px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background: linear-gradient(135deg, #c9a961, #8a5f36);
            border: none;
            border-radius: 13px;
            color: #fff;
            font-size: 14.5px;
            font-weight: 800;
            font-family: inherit;
            cursor: pointer;
            box-shadow: 0 12px 28px -10px rgba(201, 169, 97, 0.7);
            letter-spacing: 0.02em;
            transition: transform 0.1s, background 0.15s;
        }
        .btn-login:hover { background: linear-gradient(135deg, #d4b673, #9a6b3f); }
        .btn-login:active { transform: scale(0.98); }
        .btn-login:disabled { opacity: 0.6; cursor: not-allowed; }

        /* FOOTER — varies per tab */
        .tab-footer {
            margin-top: 20px;
            padding-top: 18px;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            text-align: center;
            font-size: 12.5px;
            color: #8a8378;
        }
        .tab-footer a {
            color: #c9a961;
            font-weight: 700;
            text-decoration: none;
            transition: color 0.15s;
        }
        .tab-footer a:hover { color: #d4b673; }

        /* ERROR */
        .login-error {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 11px 13px;
            background: rgba(239, 68, 68, 0.1);
            border: 1px solid rgba(239, 68, 68, 0.3);
            border-radius: 11px;
            color: #f87171;
            font-size: 12.5px;
            margin-bottom: 16px;
        }
        .login-error svg { flex-shrink: 0; }

        /* HINT BOX */
        .tab-hint {
            display: flex;
            align-items: flex-start;
            gap: 8px;
            padding: 10px 12px;
            background: rgba(201, 169, 97, 0.08);
            border: 1px solid rgba(201, 169, 97, 0.2);
            border-radius: 10px;
            font-size: 11px;
            color: #c9a961;
            line-height: 1.5;
            margin-bottom: 16px;
        }
        .tab-hint svg { flex-shrink: 0; margin-top: 1px; }

        @media (max-width: 480px) {
            .login-card { padding: 26px 20px 22px; border-radius: 20px; }
            .logo-icon { width: 56px; height: 56px; }
            .logo-title { font-size: 20px; }
        }
    </style>
</head>
